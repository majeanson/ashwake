{
  "name": "ashwake-monorepo",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @ashwake/game dev",
    "bake": "pnpm bake:icons && pnpm bake:terrain && pnpm bake:art && pnpm bake:social",
    "bake:terrain": "tsx scripts/terrain.ts",
    "bake:art": "tsx scripts/artslots.ts",
    "bake:icons": "tsx scripts/icons.ts",
    "bake:social": "tsx scripts/social.ts",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:prod": "wrangler deploy",
    "verify:deploy": "tsx scripts/verify-deploy.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "pnpm --filter @ashwake/core sim",
    "test:e2e": "pnpm build && playwright test",
    "audit:screens": "pnpm build && playwright test --config playwright.audit.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
