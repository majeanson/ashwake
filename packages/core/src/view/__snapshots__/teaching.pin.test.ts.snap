exports[`the teaching pins — every word, exactly as it reads today · en > pins every stat note on an opening board 1`] = `
{
  "cost · BARE_TUNING": "COST: the next placement’s price, 1. It rises +1 every 70 placed, and it never comes back down. It is the clock that ends every run. You may place while ANY tiles remain. The difference is forgiven at zero, and it cannot chain: only a pop lifts you back above zero.",
  "cost · TUNING": "COST: the next placement’s price, 1. It rises +1 every 22 placed, and it never comes back down. It is the clock that ends every run. You may place while ANY tiles remain. The difference is forgiven at zero, and it cannot chain: only a pop lifts you back above zero.",
  "left · BARE_TUNING": "LEFT: placements remaining in the expedition. At zero it ends; anything already ripe can still be popped.",
  "left · TUNING": "LEFT: placements remaining in the expedition. At zero it ends; anything already ripe can still be popped.",
  "luck · BARE_TUNING": "LUCK is a purse, not a score. The row under your hand spends it.",
  "luck · TUNING": "LUCK is a purse, not a score. The row under your hand spends it; whatever is left when the run ends comes home as relics, at 5%.",
  "map · BARE_TUNING": "REACH: how far from home you have built. Every 4 hexes out raises the distance multiplier by 1, so the same pocket scores more the deeper it pops.",
  "map · TUNING": "REACH: how far from home you have built. Every 3 hexes out raises the distance multiplier by 1, so the same pocket scores more the deeper it pops.",
  "points · BARE_TUNING": "POINTS: the score. A pocket popped for points pays its worth × its size × its distance from home.",
  "points · TUNING": "POINTS: the score. A pocket popped for points pays its worth × its size × its distance from home.",
  "tiles · BARE_TUNING": "TILES: what keeps you alive. Every placement spends them; pops, caches and territories pay them back. At zero with nothing ripe to pop, the run ends.",
  "tiles · TUNING": "TILES: what keeps you alive. Every placement spends them; pops, caches and territories pay them back. At zero with nothing ripe to pop, the run ends.",
}
`;

exports[`the teaching pins — every word, exactly as it reads today · en > pins the colour lessons and THE FOUR GROUNDS, over both tunings and both directions 1`] = `
{
  "grounds · blue · TUNING · daylight": "ROADS. Worth little at home, a lot on the frontier: +1 worth per 6 hexes from home. | PICK IT WHEN Far from home, up to +1. | WATCH FOR Its extra is small (at most +1), so near home or on its own it is just plain matches. Choose it where it also has neighbours of its own colour.",
  "grounds · blue · TUNING · settlement": "ROADS. Worth little at home, a lot on the frontier: +1 worth per 6 hexes from home. | PICK IT WHEN Far from home, up to +1. | WATCH FOR Its extra is small (at most +1), so near home or on its own it is just plain matches. Choose it where it also has neighbours of its own colour.",
  "grounds · detail · BARE_TUNING · daylight": "A pocket pays all its tiles’ worth added up, so plan the pocket and not the single tile. | No ground wins everywhere. MARKET is steady, FARM climbs highest in a crowd, QUARRY grows as the ground is spent, and ROADS pays far from home. | Popped ground turns to stone. It helps tiles ripen, but it pays no one a match. | Distance raises every pocket’s multiplier the same way, so as a run goes on, build outward. | You cannot always pick your ground. Take the one that suits the spot you are about to fill, and spend luck to steer your hand when a big pocket is waiting for one.",
  "grounds · detail · BARE_TUNING · settlement": "A pocket pays all its tiles’ worth added up, so plan the pocket and not the single tile. | No ground wins everywhere. MARKET is steady, FARM climbs highest in a crowd, QUARRY grows as the ground is spent, and ROADS pays far from home. | Popped ground turns to stone. It helps tiles ripen, but it pays no one a match. | Distance raises every pocket’s multiplier the same way, so as a run goes on, build outward. | You cannot always pick your ground. Take the one that suits the spot you are about to fill, and spend luck to steer your hand when a big pocket is waiting for one.",
  "grounds · detail · TUNING · daylight": "A pocket pays all its tiles’ worth added up, so plan the pocket and not the single tile. | No ground wins everywhere. MARKET is steady, FARM climbs highest in a crowd, QUARRY grows as the ground is spent, and ROADS pays far from home. | Popped ground turns to stone. It helps tiles ripen, but it pays a match only to QUARRY. | Distance raises every pocket’s multiplier the same way, so as a run goes on, build outward. | You cannot always pick your ground. Take the one that suits the spot you are about to fill, and spend luck to steer your hand when a big pocket is waiting for one.",
  "grounds · detail · TUNING · settlement": "A pocket pays all its tiles’ worth added up, so plan the pocket and not the single tile. | No ground wins everywhere. MARKET is steady, FARM climbs highest in a crowd, QUARRY grows as the ground is spent, and ROADS pays far from home. | Popped ground turns to stone. It helps tiles ripen, but it pays a match only to QUARRY. | Distance raises every pocket’s multiplier the same way, so as a run goes on, build outward. | You cannot always pick your ground. Take the one that suits the spot you are about to fill, and spend luck to steer your hand when a big pocket is waiting for one.",
  "grounds · green · TUNING · daylight": "FARM. Wants one big mob of its own colour: +0.7 worth per FARM neighbour past the first. | PICK IT WHEN When you can keep one crowd growing: ringed by its own colour, a tile is worth 9.5. | WATCH FOR Alone in mixed ground it earns no bonus, only plain matches.",
  "grounds · green · TUNING · settlement": "FARM. Wants one big mob of its own colour: +0.7 worth per FARM neighbour past the first. | PICK IT WHEN When you can keep one crowd growing: ringed by its own colour, a tile is worth 9.5. | WATCH FOR Alone in mixed ground it earns no bonus, only plain matches.",
  "grounds · red · TUNING · daylight": "QUARRY. Stone and walls count as matches for it: it feeds on the spent ground everyone else abandons. | PICK IT WHEN Beside stone and walls. Your own pops leave stone, so it gets better as a run goes on. | WATCH FOR On fresh open ground it earns only plain matches.",
  "grounds · red · TUNING · settlement": "QUARRY. Stone and walls count as matches for it: it feeds on the spent ground everyone else abandons. | PICK IT WHEN Beside stone and walls. Your own pops leave stone, so it gets better as a run goes on. | WATCH FOR On fresh open ground it earns only plain matches.",
  "grounds · yellow · TUNING · daylight": "MARKET. Scores in messy mixed ground: +1 worth per differently-coloured neighbour. | PICK IT WHEN When the ground around you is mixed: once ringed, it is worth 6. | WATCH FOR Stone, walls and the map’s edge pay it nothing, and it gives other colours no match. Late in a run, as pops leave stone, it earns less.",
  "grounds · yellow · TUNING · settlement": "MARKET. Scores in messy mixed ground: +1 worth per differently-coloured neighbour. | PICK IT WHEN When the ground around you is mixed: once ringed, it is worth 6. | WATCH FOR Stone, walls and the map’s edge pay it nothing, and it gives other colours no match. Late in a run, as pops leave stone, it earns less.",
  "lesson · blue · BARE_TUNING · daylight": null,
  "lesson · blue · BARE_TUNING · settlement": null,
  "lesson · blue · TUNING · daylight": "ROADS. Worth little at home, a lot on the frontier: +1 worth per 6 hexes from home.",
