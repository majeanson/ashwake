exports[`the teaching pins — every word, exactly as it reads today · en > pins every perk’s rows, as both its hosts draw them 1`] = `
[
  {
    "id": "rootbound",
    "rows": [
      {
        "text": "YOU GAIN: Your own ground pays 1.35× to start and 2× at full luck. The ground’s own bonus is counted first, then the whole lot multiplies.",
      },
      {
        "text": "YOU LOSE: Ground that is not yours pays 0.5× to start, and NOTHING once your luck is full. The better your odds get, the less the plane forgives.",
      },
      {
        "text": "PLAY IT: Grow along ONE colour’s field and pop inside it. Early on a strayed pocket still pays something; bank enough luck and it stops paying at all, so the rule gets stricter exactly as you get richer.",
      },
    ],
  },
  {
    "id": "secondwind",
    "rows": [
      {
        "text": "YOU GAIN: The first time a run would end BROKE, a coin is flipped: 50% of the time you carry on with 20 tiles.",
      },
      {
        "text": "YOU LOSE: Nothing you had. The coin is flipped once a run, and only for running BROKE; any other ending is still an ending.",
      },
      {
        "text": "PLAY IT: A reprieve you cannot count on, so it is worth one placement more than you would dare, not ten. If the coin lands, reach a pocket and POP before the 20 tiles are gone.",
      },
    ],
  },
  {
    "id": "stonewalker",
    "rows": [
      {
        "text": "YOU GAIN: Placements next to stone cost 1 less, down to free and never below it.",
      },
      {
        "text": "YOU LOSE: Nothing. This one is pure discount.",
      },
      {
        "text": "PLAY IT: Stone stops being ground to route around and becomes the cheapest ground there is. Build ALONG a ridge rather than away from one.",
      },
    ],
  },
  {
    "id": "wallbreaker",
    "rows": [
      {
        "text": "YOU GAIN: Walls can be built ON, which nothing else in the game can do.",
      },
      {
        "text": "YOU LOSE: A wall placement costs 2× a normal one, and the tiles are spent whether or not the pocket ever ripens.",
      },
      {
        "text": "PLAY IT: A wall surrounds without ever matching, so breaking one JOINS two pockets that could never have touched. Worth it to close a big pocket; never worth it to save a step.",
      },
    ],
  },
  {
    "id": "openhand",
    "rows": [
      {
        "text": "YOU GAIN: You draft 5 tiles every hand instead of the usual deal.",
      },
      {
        "text": "YOU LOSE: NO STASH. The shelf disappears while this is worn, so nothing can be put by for later.",
      },
      {
        "text": "PLAY IT: More choice now, none saved. Take the best of 5 every single turn instead of banking a tile for a pocket two moves away.",
      },
    ],
  },
]
`;

