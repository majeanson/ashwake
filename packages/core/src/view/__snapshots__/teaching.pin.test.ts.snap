exports[`the teaching pins — every word, exactly as it reads today · fr-CA > pins every perk’s rows, as both its hosts draw them 1`] = `
[
  {
    "id": "rootbound",
    "rows": [
      {
        "text": "TU GAGNES : Ton propre sol paie 1.35× au départ et 2× à pleine chance. Le bonus du sol est compté d’abord, puis le tout multiplie.",
      },
      {
        "text": "TU PERDS : Le sol qui n’est pas à toi paie 0.5× au départ, et RIEN une fois ta chance pleine. Plus tes chances montent, moins la plaine pardonne.",
      },
      {
        "text": "COMMENT JOUER : Pousse le long du champ d’UNE couleur et récolte dedans. Au début, une poche qui déborde paie encore quelque chose; amasse assez de chance et elle ne paie plus du tout, alors la règle se durcit exactement quand tu t’enrichis.",
      },
    ],
  },
  {
    "id": "secondwind",
    "rows": [
      {
        "text": "TU GAGNES : La première fois qu’une partie finirait À SEC, on tire à pile ou face : 50 % du temps tu continues avec 20 tuiles.",
      },
      {
        "text": "TU PERDS : Rien de ce que tu avais. La pièce ne se lance qu’une fois par partie, et seulement pour une fin À SEC; toute autre fin reste une fin.",
      },
      {
        "text": "COMMENT JOUER : Un sursis sur lequel tu ne peux pas compter, alors ça vaut une pose de plus que tu n’oserais, pas dix. Si la pièce tombe du bon bord, rejoins une poche et RÉCOLTE avant que les 20 tuiles soient parties.",
      },
    ],
  },
  {
    "id": "stonewalker",
    "rows": [
      {
        "text": "TU GAGNES : Les poses à côté de la pierre coûtent 1 de moins, jusqu’à gratuit et jamais en dessous.",
      },
      {
        "text": "TU PERDS : Rien. Celui-là, c’est du rabais pur.",
      },
      {
        "text": "COMMENT JOUER : La pierre arrête d’être un sol à contourner et devient le sol le moins cher qui soit. Bâtis LE LONG d’une crête plutôt qu’en t’en éloignant.",
      },
    ],
  },
  {
    "id": "wallbreaker",
    "rows": [
      {
        "text": "TU GAGNES : On peut bâtir SUR les murs, ce que rien d’autre dans le jeu ne peut faire.",
      },
      {
        "text": "TU PERDS : Une pose sur un mur coûte 2× une pose normale, et les tuiles sont dépensées que la poche mûrisse un jour ou non.",
      },
      {
        "text": "COMMENT JOUER : Un mur entoure sans jamais ressembler, alors en briser un JOINT deux poches qui n’auraient jamais pu se toucher. Ça vaut la peine pour fermer une grosse poche; jamais pour sauver un pas.",
      },
    ],
  },
  {
    "id": "openhand",
    "rows": [
      {
        "text": "TU GAGNES : Tu pioches 5 tuiles à chaque main au lieu de la donne habituelle.",
      },
      {
        "text": "TU PERDS : PAS DE RÉSERVE. L’étagère disparaît tant que tu le portes, alors rien ne peut être mis de côté pour plus tard.",
      },
      {
        "text": "COMMENT JOUER : Plus de choix maintenant, rien de gardé. Prends la meilleure des 5 à chaque tour au lieu de mettre une tuile de côté pour une poche à deux coups de là.",
      },
    ],
  },
]
`;

